# Copy to .env for `docker compose up`. Every value here is a placeholder.

# Required by the Compose stack. Generate one with: openssl rand -hex 64
SECRET_KEY_BASE=

# Password for the Compose PostgreSQL service.
POSTGRES_PASSWORD=development-only

# Host port for the web container.
WEB_PORT=8860

# Leave the three TWILIO_* values empty to use the log adapter: messages are
# written to the Rails log instead of being sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
