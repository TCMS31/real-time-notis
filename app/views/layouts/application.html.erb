<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Real-time Notis" %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# One Bootstrap bundle: it already contains Popper. The previous layout %>
    <%# loaded bootstrap.bundle, popper and bootstrap separately. %>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN"
          crossorigin="anonymous">
    <script defer
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
            crossorigin="anonymous"></script>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="app-body">
    <%= render "shared/navbar" %>

    <main class="container py-4">
      <div class="row justify-content-center">
        <div class="col-lg-8"><%= render "shared/flash" %></div>
      </div>
      <%= yield %>
    </main>
  </body>
</html>
