<% content_for :title, "Account · Real-time Notis" %>

<div class="app-auth">
  <h1>Your account</h1>

  <div class="app-card">
    <%= render "devise/shared/error_messages", resource: resource %>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
                 html: { method: :put }) do |f| %>
      <%# name and phone_number are permitted by ApplicationController but the %>
      <%# generated form never rendered them, so they could not be changed. %>
      <div class="mb-3">
        <%= f.label :name, "Full name", class: "form-label" %>
        <%= f.text_field :name, class: "form-control", autocomplete: "name" %>
      </div>

      <div class="mb-3">
        <%= f.label :phone_number, "Mobile number", class: "form-label" %>
        <%= f.text_field :phone_number, class: "form-control",
                         placeholder: "+14155552671", inputmode: "tel" %>
      </div>

      <div class="mb-3">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, class: "form-control", autocomplete: "email" %>
      </div>

      <div class="mb-3">
        <%= f.label :password, "New password", class: "form-label" %>
        <%= f.password_field :password, class: "form-control", autocomplete: "new-password" %>
        <div class="form-text">Leave blank to keep your current password.</div>
      </div>

      <div class="mb-3">
        <%= f.label :password_confirmation, "Confirm new password", class: "form-label" %>
        <%= f.password_field :password_confirmation, class: "form-control", autocomplete: "new-password" %>
      </div>

      <div class="mb-3">
        <%= f.label :current_password, class: "form-label" %>
        <%= f.password_field :current_password, class: "form-control", autocomplete: "current-password" %>
        <div class="form-text">Required to confirm any change.</div>
      </div>

      <%= f.submit "Update account", class: "btn btn-primary w-100" %>
    <% end %>
  </div>

  <div class="app-auth-links">
    <%= button_to "Delete my account", registration_path(resource_name),
                  method: :delete, class: "btn btn-link text-danger p-0",
                  form: { data: { turbo_confirm: "Delete your account? This cannot be undone." } } %>
  </div>
</div>
